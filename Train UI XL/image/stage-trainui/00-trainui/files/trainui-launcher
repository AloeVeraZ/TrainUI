#!/usr/bin/env bash
set -uo pipefail

export TRAINUI_CONFIG=/etc/trainui/config.json
export PYTHONUNBUFFERED=1

TRAINUI_STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/trainui"
TRAINUI_LOG_FILE="$TRAINUI_STATE_DIR/trainui.log"
TRAINUI_LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/trainui-${UID}.lock"
TRAINUI_HEARTBEAT_FILE="${XDG_RUNTIME_DIR:-/tmp}/trainui-${UID}.heartbeat"
TRAINUI_SCHEDULE_SLEEP_MARKER="/run/trainui/display-sleep-v2"
HEARTBEAT_TIMEOUT_SECONDS=45
MAX_RUNTIME_SECONDS=86400
export TRAINUI_HEARTBEAT_FILE

mkdir -p "$TRAINUI_STATE_DIR"
exec 9>"$TRAINUI_LOCK_FILE"
flock -n 9 || exit 0

rotate_display() {
    local display_output=""

    if command -v wlr-randr >/dev/null 2>&1; then
        for _ in $(seq 1 20); do
            display_output="$(wlr-randr 2>/dev/null | awk '/^[^[:space:]]/ {print $1; exit}')"
            if [ -n "$display_output" ] && \
               wlr-randr --output "$display_output" --transform 270 \
                   >>"$TRAINUI_LOG_FILE" 2>&1; then
                return 0
            fi
            sleep 0.5
        done
    fi

    if command -v xrandr >/dev/null 2>&1; then
        display_output="$(xrandr --query 2>/dev/null | awk '/ connected/{print $1; exit}')"
        if [ -n "$display_output" ]; then
            xrandr --output "$display_output" --rotate left \
                >>"$TRAINUI_LOG_FILE" 2>&1 || true
        fi
    fi
}

hide_pointer() {
    if [ -n "${DISPLAY:-}" ]; then
        xsetroot -cursor_name none >/dev/null 2>&1 || true
        unclutter -idle 0.1 -root >/dev/null 2>&1 &
    fi
}

keep_display_awake() {
    while true; do
        if [ -e "$TRAINUI_SCHEDULE_SLEEP_MARKER" ]; then
            sleep 2
            continue
        fi

        if command -v xset >/dev/null 2>&1; then
            xset s off >/dev/null 2>&1 || true
            xset s noblank >/dev/null 2>&1 || true
            xset -dpms >/dev/null 2>&1 || true
            xset dpms force on >/dev/null 2>&1 || true
        fi

        if command -v wlr-randr >/dev/null 2>&1; then
            wlr-randr 2>/dev/null | awk '
                /^[^[:space:]]/ { output=$1 }
                /Enabled: no/ && output != "" { print output }
            ' | while IFS= read -r disabled_output; do
                wlr-randr --output "$disabled_output" --on \
                    >>"$TRAINUI_LOG_FILE" 2>&1 || true
            done
        fi
        sleep 30
    done
}

printf '\n===== TrainUI startup: %s =====\n' "$(date)" >>"$TRAINUI_LOG_FILE"
hide_pointer
keep_display_awake &
TRAINUI_DISPLAY_WATCHDOG_PID=$!
TRAINUI_APP_PID=""
TRAINUI_STARTUP_READY=false

stop_app() {
    [ -n "$TRAINUI_APP_PID" ] || return 0
    kill "$TRAINUI_APP_PID" 2>/dev/null || return 0

    for _ in $(seq 1 5); do
        kill -0 "$TRAINUI_APP_PID" 2>/dev/null || return 0
        sleep 1
    done

    kill -KILL "$TRAINUI_APP_PID" 2>/dev/null || true
}

cleanup() {
    stop_app
    kill "$TRAINUI_DISPLAY_WATCHDOG_PID" 2>/dev/null || true
    rm -f "$TRAINUI_HEARTBEAT_FILE"
}
trap cleanup EXIT
trap 'exit 0' INT TERM

cd /opt/trainui
while true; do
    if [ "$TRAINUI_STARTUP_READY" = false ]; then
        rotate_display
        TRAINUI_STARTUP_READY=true
    fi

    rm -f "$TRAINUI_HEARTBEAT_FILE"
    app_started_at="$(date +%s)"
    restart_reason="TrainUI exited"

    /opt/trainui/.venv/bin/python /opt/trainui/timertest.py \
        >>"$TRAINUI_LOG_FILE" 2>&1 &
    TRAINUI_APP_PID=$!
    echo "TrainUI process $TRAINUI_APP_PID started." >>"$TRAINUI_LOG_FILE"

    while kill -0 "$TRAINUI_APP_PID" 2>/dev/null; do
        sleep 2

        now="$(date +%s)"
        heartbeat_at="$app_started_at"
        if [ -e "$TRAINUI_HEARTBEAT_FILE" ]; then
            heartbeat_at="$(stat -c %Y "$TRAINUI_HEARTBEAT_FILE" 2>/dev/null || echo "$app_started_at")"
        fi

        if [ "$((now - heartbeat_at))" -gt "$HEARTBEAT_TIMEOUT_SECONDS" ]; then
            restart_reason="Clock heartbeat was stale for more than ${HEARTBEAT_TIMEOUT_SECONDS}s"
            stop_app
            break
        fi

        if [ "$((now - app_started_at))" -ge "$MAX_RUNTIME_SECONDS" ]; then
            restart_reason="Daily preventive restart"
            stop_app
            break
        fi
    done

    if wait "$TRAINUI_APP_PID"; then
        exit_code=0
    else
        exit_code=$?
    fi
    printf '%s (exit %s); restarting in 3 seconds.\n' \
        "$restart_reason" "$exit_code" >>"$TRAINUI_LOG_FILE"
    TRAINUI_APP_PID=""
    rm -f "$TRAINUI_HEARTBEAT_FILE"
    sleep 3
done
