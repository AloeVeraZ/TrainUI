IMG_NAME='TrainUI'
PI_GEN_RELEASE='TrainUI custom Raspberry Pi OS image'
RELEASE='trixie'
DEPLOY_COMPRESSION='xz'
COMPRESSION_LEVEL='6'

# The original Raspberry Pi Zero W requires the 32-bit master branch of pi-gen.
TARGET_HOSTNAME='trainui'
LOCALE_DEFAULT='en_US.UTF-8'
KEYBOARD_KEYMAP='us'
KEYBOARD_LAYOUT='English (US)'
TIMEZONE_DEFAULT='America/New_York'
WPA_COUNTRY='US'
ENABLE_SSH='1'
ENABLE_CLOUD_INIT='1'

# Stage 4 is the normal Raspberry Pi OS desktop image. The final custom stage
# adds TrainUI and is the only stage exported by image/build.sh.
STAGE_LIST='stage0 stage1 stage2 stage3 stage4 stage-trainui'

